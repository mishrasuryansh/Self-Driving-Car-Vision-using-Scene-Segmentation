# ==============================================================================
# Self-Driving Car Vision using Scene Segmentation - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust values as needed for local development.

# ------------------------------------------------------------------------------
# 1. Service Ports
# ------------------------------------------------------------------------------
# Public port for the React frontend container
FRONTEND_PORT=3000

# Public port for the FastAPI backend container
BACKEND_PORT=8000

# Port exposed by the MongoDB container
DB_PORT=27017

# Port exposed by the Redis container
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 2. Database & Cache Connections
# ------------------------------------------------------------------------------
# MongoDB connection URI for backend, worker, and inference services
MONGODB_URI=mongodb://admin:secretpassword@db:27017/self_driving_db?authSource=admin

# MongoDB root username for container initialization
MONGO_INITDB_ROOT_USERNAME=admin

# MongoDB root password for container initialization
MONGO_INITDB_ROOT_PASSWORD=secretpassword

# Initial MongoDB database name
MONGO_INITDB_DATABASE=self_driving_db

# Redis connection URL for Celery/RQ job queue and caching
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# ------------------------------------------------------------------------------
# Secret key used for signing JWT authentication tokens
JWT_SECRET=change-this-to-a-secure-random-secret-key

# Hashing algorithm for JWT tokens
JWT_ALGORITHM=HS256

# Expiration window for access tokens (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 4. Storage & Media Processing
# ------------------------------------------------------------------------------
# Container path for raw user-uploaded media files
STORAGE_UPLOADS_PATH=/app/storage/uploads

# Container path for processed segmentation output files
STORAGE_OUTPUTS_PATH=/app/storage/outputs

# Maximum allowed image upload size (in MB)
MAX_IMAGE_SIZE_MB=10

# Maximum allowed video upload size (in MB)
MAX_VIDEO_SIZE_MB=100

# Maximum allowed video duration (in seconds)
MAX_VIDEO_DURATION_SECONDS=60

# ------------------------------------------------------------------------------
# 5. Inference Engine & AI Models
# ------------------------------------------------------------------------------
# Path to deep learning model weights file
MODEL_WEIGHTS_PATH=/app/inference-engine/weights/deeplabv3_resnet101.pth

# Execution device for inference (cpu or cuda)
MODEL_DEVICE=cpu
